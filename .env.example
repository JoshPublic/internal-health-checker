# Example local environment for running the app on a developer machine
SERVICE_NAME=health-alpha
SERVICE_VERSION=1.0.0
SERVICE_STATUS=ok
PORT=8080
LOG_LEVEL=info
CHECK_INTERVAL_SECONDS=30
ALERT_MODE=log
ALERT_WEBHOOK_URL=
MONITORED_TARGETS=health-beta=http://localhost:8081/health

# Optional alternative format:
# TARGET_0_NAME=health-beta
# TARGET_0_URL=http://localhost:8081/health
